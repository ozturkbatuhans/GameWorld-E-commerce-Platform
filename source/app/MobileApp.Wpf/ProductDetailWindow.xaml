<Window x:Class="MobileApp.Wpf.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MobileApp.Wpf"
        mc:Ignorable="d"
        Title="ProductDetailWindow" Height="450" Width="800">
    <StackPanel Margin="10">
        <Image x:Name="ProductImage" Height="200" Stretch="Uniform" Margin="0,0,0,10"/>
        
        <TextBlock x:Name="ProductName" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock x:Name="ProductPrice" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock x:Name="ProductStock" FontSize="16" Margin="0,0,0,10"/>
        <TextBlock x:Name="ProductDescription" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
